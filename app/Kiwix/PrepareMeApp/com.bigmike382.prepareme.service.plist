<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The phones' file service inside PrepareMe.app (plan phase 6, owner's choice C, 2026-10-13): the app registers it
     with SMAppService and macOS keeps it running, open window or not, app running or not. No output paths: macOS
     refuses them from a sandboxed app (FINDINGS F-067); `library --agent` writes its own log. kiwix-mac/build.sh puts it in
     Contents/Library/LaunchAgents and the program in Contents/MacOS. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bigmike382.prepareme.service</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/prepareme-service</string>
	<key>ProgramArguments</key>
	<array>
		<string>prepareme-service</string>
		<string>library</string>
		<string>--agent</string>
	</array>
	<key>KeepAlive</key>
	<true/>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
